# Which white-label demo this deployment is (a file in src/brand/brands/).
# Empty means the base PediClinic brand. Fixed at build time.
NEXT_PUBLIC_BRAND=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach, e.g. mailto:team@example.com
VAPID_SUBJECT=

# Lets a scheduled job trigger notification delivery without a user session.
NOTIFICATIONS_DISPATCH_SECRET=
